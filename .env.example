# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in your own values.
#
# NEVER put a real key in THIS file — it is committed to the repository.
# Real values belong in `.env`, which is gitignored.
# ---------------------------------------------------------------------------

# Required: your OpenWeatherMap API key (https://home.openweathermap.org/api_keys)
# Read by the SERVER only. It is never sent to the browser, so it must not be
# given a build-tool prefix such as VITE_ / REACT_APP_ / NEXT_PUBLIC_ — those
# are published to the client by design.
OPENWEATHER_API_KEY=your_api_key

# Optional: port the Express server listens on (default 3000)
PORT=3000

# Optional: node environment — "development" or "production" (default development)
NODE_ENV=development

# Optional: identifiable User-Agent sent to OpenStreetMap Nominatim.
# The Nominatim usage policy requires that you identify your application with a
# real contact URL or email.
# IMPORTANT: do not use an example.com address here. Nominatim rejects those
# with HTTP 403 and city search stops working. Replace `your-username` below
# with your own repository or contact details.
NOMINATIM_USER_AGENT=SkyPulseIndia/1.0 (weather forecast app; https://github.com/your-username/weather-forecast-app)

# Optional: comma-separated list of origins allowed to call the API from a
# browser on another origin. Leave empty to allow same-origin requests only.
# Example: ALLOWED_ORIGINS=https://my-weather-app.example.com
ALLOWED_ORIGINS=
